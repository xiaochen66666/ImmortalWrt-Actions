# ==================== 核心目标平台 ====================
CONFIG_TARGET_bcm53xx=y
CONFIG_TARGET_bcm53xx_DEVICE_phicomm-k3=y
CONFIG_TARGET_BOARD="bcm53xx"
CONFIG_TARGET_SUBTARGET="generic"


# ==================== 版本信息 ====================
CONFIG_VERSION_DIST="ImmortalWrt"
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org/releases/24.10-SNAPSHOT"

# ==================== K3 屏幕驱动 ====================
CONFIG_PACKAGE_k3screenctrl=y

# ==================== USB 支持（24.10 必须手动添加） ====================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_block-mount=y


# ==================== 屏幕 Luci 界面 ====================
CONFIG_PACKAGE_luci-app-k3screenctrl=y

# ==================== 必要库 ====================
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_libssp=y

# ==================== 自定义插件 ====================
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-theme-argon=y
