# ==================== 目标平台 ====================
CONFIG_TARGET_bcm53xx=y
CONFIG_TARGET_bcm53xx_generic=y
CONFIG_TARGET_bcm53xx_generic_DEVICE_phicomm_k3=y

# ==================== 固件格式 ====================
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256

# 关闭全量编译（加快速度）
CONFIG_ALL_KMODS=n
CONFIG_ALL_NONSHARED=n
CONFIG_DEVEL=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_AUTOREMOVE=y

# 构建工具（可选，云编译建议保留）
CONFIG_IB=y
CONFIG_SDK=y
CONFIG_MAKE_TOOLCHAIN=y

# 版本信息
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="ImmortalWrt"
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org/releases/24.10.6"
CONFIG_VERSION_FILENAMES=y

# 系统包（保留你原来的）
CONFIG_PACKAGE_attendedsysupgrade-common=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-i18n-attendedsysupgrade-zh-cn=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y

# 调试选项（失败时有用，但会增加体积）
CONFIG_BUILD_LOG=y
CONFIG_COLLECT_KERNEL_DEBUG=y
